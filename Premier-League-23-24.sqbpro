ter/></table><table schema="main" name="pl_table_xg_2023_24" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="29"/><column index="2" value="187"/><column index="3" value="45"/><column index="4" value="132"/><column index="5" value="132"/><column index="6" value="132"/><column index="7" value="148"/><column index="8" value="148"/><column index="9" value="29"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="possession_percentage_team" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="37"/><column index="2" value="187"/><column index="3" value="95"/><column index="4" value="54"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="possession_won_team" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="37"/><column index="2" value="187"/><column index="3" value="207"/><column index="4" value="134"/><column index="5" value="54"/><column index="6" value="52"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="team_defensive_stats" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="187"/><column index="2" value="80"/><column index="3" value="155"/><column index="4" value="127"/><column index="5" value="99"/><column index="6" value="72"/><column index="7" value="117"/><column index="8" value="169"/><column index="9" value="114"/><column index="10" value="142"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="team_offensive_stats" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort><column index="9" mode="0"/></sort><column_widths><column index="1" value="187"/><column index="2" value="75"/><column index="3" value="39"/><column index="4" value="95"/><column index="5" value="156"/><column index="6" value="107"/><column index="7" value="97"/><column index="8" value="111"/><column index="9" value="155"/><column index="10" value="154"/><column index="11" value="154"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">ALTER TABLE team_offensive_stats
ADD COLUMN &quot;touches in box per 90&quot; FLOAT;

UPDATE team_offensive_stats
SET&quot;touches in box per 90&quot; = &quot;Touches in opposition box&quot;/38;



CREATE TABLE team_defensive_stats AS
SELECT
    c.Team,
    c.&quot;Clean Sheets&quot;,
    g.&quot;Goals Conceded per Match&quot;,
    g.&quot;Total Goals Conceded&quot;,
    s.&quot;Saves per Match&quot;,
    s.&quot;Total Saves&quot;,
    w.&quot;Tackle Success (%)&quot;,
    w.&quot;Successful Tackles per Match&quot;,
    i.&quot;Total Interceptions&quot;,
    i.&quot;Interceptions per Match&quot;
	p.&quot;Possession Won Final 3rd per Match&quot;
FROM clean_sheet_team c
INNER JOIN goals_conceded_team_match g ON c.Team = g.Team
INNER JOIN saves_team s ON c.Team = s.Team
INNER JOIN won_tackle_team w ON c.Team = w.Team
INNER JOIN interception_team i ON c.Team = i.Team
INNER JOIN possession_won_team p ON c.Team = p.Team;
</sql><current_tab id="0"/></tab_sql></sqlb_project>
